# Copy this to ops/feishu_bridge.env and fill in real values, then:
#   set -a; source ops/feishu_bridge.env; set +a
#   python ops/feishu_bridge.py

# Feishu open-platform credentials (from developer console)
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only set if you enabled them in event subscription
FEISHU_VERIFY_TOKEN=
FEISHU_ENCRYPT_KEY=
# Optional but recommended when im:message.group_msg(:readonly) is granted.
# Without it the bridge can't tell if a non-@ group message was meant for
# the bot, and falls back to "treat all received as mention".
# Look up via:
#   curl -H "Authorization: Bearer <tenant_access_token>" \
#        https://open.feishu.cn/open-apis/bot/v3/info
FEISHU_BOT_OPEN_ID=

# LarkMemoryCore connection
LARK_MEMORY_CORE_BASE_URL=http://127.0.0.1:18100
# Read from .run/feishu-office-competition/runtime/api_key.txt
LARK_MEMORY_CORE_API_KEY=dev-local-key
LARK_MEMORY_CORE_MODEL=moonshot/kimi-k2.5
LARK_MEMORY_CORE_MAX_TOKENS=256

# Memory scope (must match seeded events to enable hit counts)
LARK_MEMORY_CORE_TENANT_ID=tenant-real
LARK_MEMORY_CORE_PROJECT_ID=feishu-office
